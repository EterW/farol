# Farol · configuração do assistente "Explique para mim" (OPCIONAL).
# Copie para .env (que não vai para o git) e ajuste. Reinicie o Farol depois de mudar.
# Em qualquer provedor valem as MESMAS regras: a IA só explica números já calculados, e o Farol descarta
# respostas com número/estratégia/ativo fora dos dados, previsão ou recomendação de entrada.

# desligado (padrão) | ollama (modelo local, grátis, nada sai do computador) | anthropic (API paga, externa)
ASSISTENTE_PROVEDOR=desligado

# Modelo. Padrões: ollama -> llama3.2 ; anthropic -> claude-opus-5-5 (claude-sonnet-5-5 / claude-haiku-5-5 custam menos)
ASSISTENTE_MODELO=

# --- Ollama ---------------------------------------------------------------------------------
# Instalar: winget install Ollama.Ollama   (ou https://ollama.com/download)
# Baixar o modelo: ollama pull llama3.2
ASSISTENTE_OLLAMA_URL=http://127.0.0.1:11434

# --- Anthropic ------------------------------------------------------------------------------
# Só com ASSISTENTE_PROVEDOR=anthropic. A chave fica só no servidor local.
ANTHROPIC_API_KEY=
# Esforço de raciocínio: low (padrão, mais barato), medium, high.
ASSISTENTE_ESFORCO=low

# --- Comum ----------------------------------------------------------------------------------
# Tempo limite de cada chamada em segundos (padrão: ollama 60, anthropic 20; máx. 120).
ASSISTENTE_TEMPO_LIMITE=
# Máximo de chamadas por hora, somando todas as abas (padrão: ollama 60, anthropic 20).
ASSISTENTE_LIMITE_HORA=
