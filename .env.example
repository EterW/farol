# Farol · configuração do assistente (OPCIONAL, desligado sem chave).
# Copie para .env (que não vai para o git) e preencha. A chave fica só no servidor local.
# Custos: cada "Explique para mim" é uma chamada paga à API da Anthropic.
ANTHROPIC_API_KEY=
# Modelo (padrão claude-opus-5-5). Ex.: claude-sonnet-5-5 ou claude-haiku-5-5 custam menos.
FAROL_ASSISTENTE_MODELO=claude-opus-5-5
# Máximo de chamadas por hora (somando todas as abas). 0 = nenhuma.
FAROL_ASSISTENTE_LIMITE_HORA=20
# Tempo limite de cada chamada, em segundos (3 a 60).
FAROL_ASSISTENTE_TEMPO_LIMITE=20
# Esforço de raciocínio do modelo: low (padrão, mais barato), medium, high.
FAROL_ASSISTENTE_ESFORCO=low
